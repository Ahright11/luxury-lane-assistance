# Κανόνες cache για το Cloudflare Pages.
# Χωρίς αυτό το αρχείο το Pages σερβίρει τα πάντα με max-age=0, must-revalidate,
# δηλαδή ο browser ξαναρωτάει για κάθε αρχείο σε κάθε επίσκεψη.
#
# ΠΡΟΣΟΧΗ: το Pages ΣΥΝΕΝΩΝΕΙ τους κανόνες που ταιριάζουν. Δύο κανόνες για το ίδιο
# αρχείο δίνουν διπλό Cache-Control, που είναι άκυρο — ένας κανόνας ανά οικογένεια.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Το HTML και το περιεχόμενο θέλουν πάντα φρέσκο έλεγχο
/
  Cache-Control: public, max-age=0, must-revalidate

/api/*
  Cache-Control: no-store

/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Οι εικόνες που ανεβάζει ο πελάτης έχουν μοναδικό όνομα -> ασφαλές για πάντα
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Βίντεο, εικόνες, γραμματοσειρές: αλλάζουν μόνο με νέο deploy
/assets/*
  Cache-Control: public, max-age=604800
